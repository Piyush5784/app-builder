{
  "name": "app-builder",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check": "bun install && bun run generate && turbo format && turbo run lint typecheck build",
    "db:seed": "bun run --cwd packages/db db:seed",
    "deploy:server": "sst deploy --stage production",
    "deploy:web": "turbo run build --filter=web && wrangler pages deploy apps/web/dist --project-name=app-builder-web --branch=main",
    "dev": "turbo dev",
    "dev:server:sst": "sst dev",
    "format": "turbo format && prettier --write .",
    "format:check": "prettier --check .",
    "generate": "turbo run generate",
    "lint": "turbo lint",
    "postinstall": "bun run generate",
    "prepare": "husky",
    "test": "turbo run test",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "test:e2e:browser": "bun run --cwd apps/web test:e2e --headed",
    "test:e2e:ui": "bun run --cwd apps/web test:e2e:ui",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sst": "^4.17.1",
    "turbo": "^2.9.18",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "wrangler": "^4.120.0"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
