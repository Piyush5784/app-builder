{
  "name": "server",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "test": "NODE_ENV=development bun test",
    "lint": "eslint",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@package/db": "workspace:*",
    "@package/shared": "workspace:*",
    "@zenstackhq/orm": "^3.8.3",
    "@zenstackhq/plugin-policy": "^3.8.3",
    "@zenstackhq/server": "^3.8.3",
    "archiver": "^8.0.0",
    "better-auth": "^1.6.25",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "e2b": "^2.36.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "morgan": "^1.11.0",
    "pg": "^8.22.0",
    "resend": "^6.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/pg": "^8.15.5"
  }
}
